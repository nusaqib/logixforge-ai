// The following rung moves a decimal value of "512" (bit 9 set) to the MSW command word.  This commands the SD4840E2 to Preset the current position to the Target Position value.
MOVE(512,command_data_block[0]);

// The following rung moves a decimal value of -32768 (16#8000) to Least Significant word of Command Bits.  This enables the driver causing it to send power to the motor.
MOVE(-32768,command_data_block[1]);

CPS(Target_Position,command_data_block[2],2);

// Words 4 through 9 of the 10 word command block are not used by the Preset Command.  This rung resets these words to zero.
FLL(0,command_data_block[4],6);

// Move the command block data internal to the Add on Instruction to the output registers assigned to the SD4840E2.
CPS(command_data_block[0],AMCI_SD4840E2_output_data,10);
