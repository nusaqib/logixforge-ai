// The following logic can be used to program between two and sixteen segments of an AMCI SD4840E2's assembled move.
// 
// This Add On Instruction will only work if the SD4840E2 was added to the network using EDS V1.5 file and if both the input and output data format are both set to binary.
OTE(comment_coil);

MOVE(Number_of_Segments,Assembled_Move_counter.PRE);

// The first step in programming a Assembled Move Profile is placing the SD4840E2 in Assembled Move mode.  The following rung accomplishes this by setting bit 11 in Control Word 1.  Control Word 2 is set to -32768.  This keeps the driver enabled while the Assembled Move Profile is being programmed.  Words 2 to 9 are reset to zero.
XIO(Assembled_Move_counter.DN)XIO(Axis_Status_Bits.8)CPS(Assembled_Move_setup[0],command_data_block[0],10);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,0)MOVE(6144,command_data_block[0])CPS(Segment_1_Distance,command_data_block[2],2)CPS(Segment_1_Programmed_Speed,command_data_block[4],2)MOVE(Segment_1_Acceleration,command_data_block[6])MOVE(Segment_1_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,1)MOVE(6144,command_data_block[0])CPS(Segment_2_Distance,command_data_block[2],2)CPS(Segment_2_Programmed_Speed,command_data_block[4],2)MOVE(Segment_2_Acceleration,command_data_block[6])MOVE(Segment_2_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,2)MOVE(6144,command_data_block[0])CPS(Segment_3_Distance,command_data_block[2],2)CPS(Segment_3_Programmed_Speed,command_data_block[4],2)MOVE(Segment_3_Acceleration,command_data_block[6])MOVE(Segment_3_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,3)MOVE(6144,command_data_block[0])CPS(Segment_4_Distance,command_data_block[2],2)CPS(Segment_4_Programmed_Speed,command_data_block[4],2)MOVE(Segment_4_Acceleration,command_data_block[6])MOVE(Segment_4_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,4)MOVE(6144,command_data_block[0])CPS(Segment_5_Distance,command_data_block[2],2)CPS(Segment_5_Programmed_Speed,command_data_block[4],2)MOVE(Segment_5_Acceleration,command_data_block[6])MOVE(Segment_5_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,5)MOVE(6144,command_data_block[0])CPS(Segment_6_Distance,command_data_block[2],2)CPS(Segment_6_Programmed_Speed,command_data_block[4],2)MOVE(Segment_6_Acceleration,command_data_block[6])MOVE(Segment_6_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,6)MOVE(6144,command_data_block[0])CPS(Segment_7_Distance,command_data_block[2],2)CPS(Segment_7_Programmed_Speed,command_data_block[4],2)MOVE(Segment_7_Acceleration,command_data_block[6])MOVE(Segment_7_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,7)MOVE(6144,command_data_block[0])CPS(Segment_8_Distance,command_data_block[2],2)CPS(Segment_8_Programmed_Speed,command_data_block[4],2)MOVE(Segment_8_Acceleration,command_data_block[6])MOVE(Segment_8_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,8)MOVE(6144,command_data_block[0])CPS(Segment_9_Distance,command_data_block[2],2)CPS(Segment_9_Programmed_Speed,command_data_block[4],2)MOVE(Segment_9_Acceleration,command_data_block[6])MOVE(Segment_9_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,9)MOVE(6144,command_data_block[0])CPS(Segment_10_Distance,command_data_block[2],2)CPS(Segment_10_Programmed_Speed,command_data_block[4],2)MOVE(Segment_10_Acceleration,command_data_block[6])MOVE(Segment_10_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,10)MOVE(6144,command_data_block[0])CPS(Segment_11_Distance,command_data_block[2],2)CPS(Segment_11_Programmed_Speed,command_data_block[4],2)MOVE(Segment_11_Acceleration,command_data_block[6])MOVE(Segment_11_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,11)MOVE(6144,command_data_block[0])CPS(Segment_12_Distance,command_data_block[2],2)CPS(Segment_12_Programmed_Speed,command_data_block[4],2)MOVE(Segment_12_Acceleration,command_data_block[6])MOVE(Segment_12_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,12)MOVE(6144,command_data_block[0])CPS(Segment_13_Distance,command_data_block[2],2)CPS(Segment_13_Programmed_Speed,command_data_block[4],2)MOVE(Segment_13_Acceleration,command_data_block[6])MOVE(Segment_13_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,13)MOVE(6144,command_data_block[0])CPS(Segment_14_Distance,command_data_block[2],2)CPS(Segment_14_Programmed_Speed,command_data_block[4],2)MOVE(Segment_14_Acceleration,command_data_block[6])MOVE(Segment_14_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,14)MOVE(6144,command_data_block[0])CPS(Segment_15_Distance,command_data_block[2],2)CPS(Segment_15_Programmed_Speed,command_data_block[4],2)MOVE(Segment_15_Acceleration,command_data_block[6])MOVE(Segment_15_Deceleration,command_data_block[7]);

// The SD4840E2 indicates that it is in Assembled Move mode by setting input word 0 bit 8.  The driver also sets input word 0 bit 9 to tell the PLC that it is ready to recieve a assembled move segment.  When both of these bits are set, and the counter's accumulator is equal to zero, send the length, velocity, acceleration, and deceleration paramters of the first segment to the driver.
XIO(Assembled_Move_counter.DN)XIC(Axis_Status_Bits.8)XIC(Axis_Status_Bits.9)EQ(Assembled_Move_counter.ACC,15)MOVE(6144,command_data_block[0])CPS(Segment_16_Distance,command_data_block[2],2)CPS(Segment_16_Programmed_Speed,command_data_block[4],2)MOVE(Segment_16_Acceleration,command_data_block[6])MOVE(Segment_16_Deceleration,command_data_block[7]);

// The SD4840E2 driver acknowledges the receipt of a assembled programming block by resetting bit SD4840E2_Status_Word_0.9.  When this bit is set, increment the counter controlling which programming block is being output, and unlatch the Read assembled Data bit Command_data_block[0].12.  This bit, along with bit 11 (the Program Assembled Move Profile bit)  is set in word 0 of each of the assembled segment's programming blocks.
XIC(Axis_Status_Bits.8)XIO(Axis_Status_Bits.9)[CTU(Assembled_Move_counter,?,?) ,OTU(command_data_block[0].12) ];

// If the counter Done bit is set, all of the Assembled Move Profile's programming blocks have been sent to the SMD23E driver.  When this bit is set, exit Assembled Move mode by resetting Control Word 1 to zero.  To keep the driver enabled, Control Word 2 is set to -32768.  The remaining eight output words assigned to the SMD23E are also reset to zero.  
// 
// After all of these operations have been performed, disable the calling of the program_assembled subroutine by resetting tag SMD23E_assembled_move to zero.
XIC(Assembled_Move_counter.DN)MOVE(0,command_data_block[0])MOVE(-32768,command_data_block[1])FLL(0,command_data_block[2],8)RES(Assembled_Move_counter)OTL(Assembled_Move_Programmed);

// Move the command block data internal to the Add on Instruction to the output registers assigned to the SD4840E2.
CPS(command_data_block[0],AMCI_SD4840E2_output_data,10);
