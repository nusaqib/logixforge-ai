// The following rung moves a decimal value of "32" (bit 5 set) to the MSW command word.  This commands the SD4840E2 to perform a CW Home Operation.
XIO(Axis_Status_Bits.0)XIO(Axis_Status_Bits.1)XIO(EN)MOVE(32,command_data_block[0]);

// The following rung moves a value of 0 to output word 0 while motion is occurring.  This will allow the SD4840E2 to see the next 0 to 1 transition of the command bit.
[XIC(Axis_Status_Bits.0) ,XIC(Axis_Status_Bits.1) ]MOVE(0,command_data_block[0]);

// The following rung moves a decimal value of -32768 (16#8000) to Least Significant word of Command Bits.  This enables the driver causing it to send power to the motor.
XIO(Type_0_for_standard_1_for_indexed)MOVE(-32768,command_data_block[1]);

// The following rung moves a decimal value of -32512 (16#8100) to Least Significant word of Command Bits.  This enables the driver causing it to send power to the motor, and sets the move type as an indexed move that only begins when an input is activated.
XIC(Type_0_for_standard_1_for_indexed)MOVE(-32512,command_data_block[1]);

// The Home CW Move command does not use the data in the target position registers and the following rung resets these two registers to zero.
FLL(0,command_data_block[2],2);

CPS(Programmed_Speed,command_data_block[4],2);

// Move the acceleration value from outside the AOI instruction to word six of the ten word command block.
MOVE(Acceleration,command_data_block[6]);

// Move the deceleration value from outside the AOI instruction to word seven of the ten word command block.
MOVE(Deceleration,command_data_block[7]);

// If the motor current field is zero or greater than 40, move zero into word 8, the motor current value, of the command data block.
[EQ(motor_current,0) ,GT(motor_current,40) ]MOVE(0,command_data_block[8]);

// If the motor current field is between 1 and 40, set the bit that enables the changing of the motor current to the new value and  move the motor current value into word 8 of the command data block.
LIMIT(1,motor_current,40)OTL(command_data_block[1].1)MOVE(motor_current,command_data_block[8]);

// Move the Acceleration Jerk value from outside the AOI instruction to word nine of the ten word command block.
MOVE(Jerk,command_data_block[9]);

[XIC(Axis_Status_Bits.11) ,XIC(Axis_Status_Bits.12) ,XIC(Axis_Status_Bits.13) ]OTE(ER)MOVE(0,command_data_block[0]);

OTL(EN);

// Move the command block data internal to the Add on Instruction to the output registers assigned to the SD4840E2.
CPS(command_data_block[0],AMCI_SD4840E2_output_data,10);
