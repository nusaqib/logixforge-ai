namespace ViewDesigner::AOG;

using HMICatalog;

/* HMI Device Type: 15" PanelView 5510 2715P-T15CD */

AddOnGraphic LED_Status_Inverse {
	Description := "";
	Vendor := "";
	Major := 1;
	Minor := 0;
	Extended := "";
	Note := "";
	Width := 15;
	Height := 15;
	TerminalWidth := 1024;
	TerminalHeight := 768;
	UserProperties {
		^Tag {
			DataType := "BOOL";
			Description := "";
			Category := "General";
		}
	}
	Ellipse Ellipse_001 {
		Border {
			Color := "#1e2e3e";
			BorderStyle {
				Line := PenStyle.SolidLine;
				Cap := CapStyle.SquareCap;
				Join := JoinStyle.MiterJoin;
			}
			Width := 1;
		}
		FillColor := "linear-gradient(to bottom, #d1d3d4 0.00%, #939598 100.00%)";
		ColorStateTable ColorTable_001 {
			Expression := "" -> "Tag";
			State State1 (
				fillcolor := "#51e79a")
			{
				value := "0";
			}
			State DefaultState (
				fillcolor := "linear-gradient(to bottom, #d1d3d4 0.00%, #939598 100.00%)")
			{
			}
		}
		X := 0;
		Y := 0;
		Width := 15;
		Height := 15;
		Angle := 0;
		Enabled := true;
		^Visible := true;
		Opacity := 100;
		Access := EnumElementAccessFamily.Inherit;
	}
}
